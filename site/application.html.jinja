{% block preamble %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ demo.description }}">
<link rel="canonical" href="{{ site_origin }}{{ demo.route }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Bokeh demos">
<meta property="og:title" content="{{ demo.title }} · Bokeh demos">
<meta property="og:description" content="{{ demo.description }}">
<meta property="og:url" content="{{ site_origin }}{{ demo.route }}">
<meta property="og:image" content="{{ site_origin }}/assets/social-preview.png?v=1">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ demo.title }} · Bokeh demos">
<meta name="twitter:description" content="{{ demo.description }}">
<meta name="twitter:image" content="{{ site_origin }}/assets/social-preview.png?v=1">
<link rel="icon" href="/assets/bokeh-icon.svg?v=2" type="image/svg+xml" sizes="any">
<link rel="icon" href="/favicon.ico?v=2" type="image/png" sizes="16x16">
<link rel="stylesheet" href="/assets/site.css?v=13">
{% endblock %}

{% block contents %}
{{ site_header | safe }}
<main class="application-page" id="main-content">
  <section class="application-intro">
    <div>
      <p class="section-kicker"><span></span>{{ demo.eyebrow }}</p>
      <h1>{{ demo.title }}</h1>
      <p>{{ demo.description }}</p>
    </div>
    <div class="application-meta">
      <p>{{ demo.domain }}<br><span>{{ demo.runtime }}</span></p>
      <div class="application-links">
        <a href="{{ demo.source_url }}">View demo source code <span aria-hidden="true">↗</span></a>
        <a href="/#run-locally">Run locally <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>
  <section class="application-canvas" aria-label="Interactive Bokeh application" aria-busy="true">
    <div class="application-loading" role="status" aria-live="polite">
      <div><span aria-hidden="true"></span>Loading interactive demo…</div>
    </div>
    {{ super() }}
  </section>
  <p class="session-note">This page uses a stateful Python session. Reload it to start a new session.</p>
</main>
{{ site_footer | safe }}
{% endblock %}
