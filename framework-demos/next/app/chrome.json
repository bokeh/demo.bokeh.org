  "intro": "<section class=\"application-intro\"><div><p class=\"section-kicker\"><span></span>Next.js + Bokeh</p><h1>Where waves meet</h1><p>Two sources, one interference field. Tune their rhythm and watch bands of constructive and destructive interference take shape.</p></div><div class=\"application-meta\"><p>Waves · images · animation<br><span>Standalone BokehJS · 4.0.0-dev.5</span></p><span class=\"framework-tag\">App Router · static export · client components</span><div class=\"application-links\"><a href=\"https://github.com/bokeh/demo.bokeh.org/tree/main/framework-demos/next\">View full app source <span aria-hidden=\"true\">↗</span></a></div></div></section>",
  "embedExample": "<section class=\"embed-example\" aria-label=\"Framework embedding example\"><div><p class=\"eyebrow\">Framework adapter</p><h2>Embed Bokeh in Next.js</h2><p>Mount two Bokeh plots or tables in separate page elements. See the full app source for model creation, data and controls.</p></div><pre><code>\"use client\"\nimport {BokehDocument, BokehRoot} from \"@bokeh/react\"\n\n&lt;BokehDocument models={dashboard.models}&gt;\n  &lt;section&gt;&lt;BokehRoot model={dashboard.field}/&gt;&lt;/section&gt;\n  &lt;aside&gt;&lt;BokehRoot model={dashboard.profile}/&gt;&lt;/aside&gt;\n&lt;/BokehDocument&gt;</code></pre></section>"
}
